/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

//
// General configuration options
//

process {
    withName: 'GUNZIP_.*' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_reference
        ]
    }

    withName: 'ARTIC_GUPPYPLEX' {
        ext.args = params.primer_set == 'artic' ? (params.primer_set_version.toString() == '1200' ? '--min-length 250 --max-length 1500' : '--min-length 200 --max-length 700') : ''
        publishDir = [
            path: { "${params.outdir}/guppyplex" },
            enabled: false
        ]
    }

    withName: 'ARTIC_MINION' {
        ext.args = '--normalise 500'
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}" },
            mode: params.publish_dir_mode,
            pattern: "*.{sorted.bam,sorted.bam.bai,fail.vcf,merged.vcf,primers.vcf,gz,tbi,consensus.fasta}"
        ]
    }

    withName: 'VCFLIB_VCFUNIQ' {
        ext.prefix = { "${meta.id}.pass.unique" }
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:.*:TABIX_TABIX' {
        ext.args = '-p vcf -f'
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: MINIMAP2_INDEX {
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/index" },
            mode: params.publish_dir_mode,
            pattern: "*.mmi"
        ]
    }

    withName: MINIMAP2_ALIGN {
        ext.args   = '-a -x map-ont'
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/align" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: ARTIC_ALIGNTRIM {
        ext.args   = '--normalise 500 --primer-match-threshold 35 --min-mapq 20'
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/align" },
            mode: params.publish_dir_mode,
            pattern: "*.{bam,bam.bai}",
        ]
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sort" }
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/align" },
            mode: params.publish_dir_mode,
            pattern: "*.bam"
        ]
    }

    withName: 'CLAIR3' {
        ext.args   = '--enable_long_indel --chunk_size=10000 --haploid_sensitive --no_phasing_for_fa --include_all_ctgs --enable_variant_calling_at_sequence_head_and_tail'
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/clair3" },
            mode: params.publish_dir_mode,
            pattern: '*.{vcf,vcf.gz}'
        ]
    }

    withName: 'BCFTOOLS_FILTER' {
        ext.args = "--output-type z --include 'FORMAT/DP >= 20'"
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/clair3" },
            mode: params.publish_dir_mode,
            pattern: '*.{vcf,vcf.gz}'
        ]
    }

    withName: 'BCFTOOLS_INDEX' {
        ext.args = '--tbi'
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/clair3" },
            mode: params.publish_dir_mode,
            pattern: '*.tbi'
        ]
    }

    withName: 'BCFTOOLS_NORM' {
        ext.args = '--check-ref x -Oz --multiallelics -any --write-index=tbi'
        ext.prefix = { "${meta.id}.norm" }
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/clair3" },
            mode: params.publish_dir_mode,
            pattern: "*.{vcf.gz,tbi}"
        ]
    }

    withName: 'BCFTOOLS_CONSENSUS_FILTER' {
        ext.args = "--output-type z --include 'FORMAT/AF >= 0.75'"
        ext.prefix = { "${meta.id}.consensus" }
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/bcftools" },
            mode: params.publish_dir_mode,
            pattern: '*.{vcf,vcf.gz}'
        ]
    }

    withName: 'BCFTOOLS_INDEX_FILTER' {
        ext.args = '--tbi'
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/bcftools" },
            mode: params.publish_dir_mode,
            pattern: '*.tbi'
        ]
    }

    withName: '.*:.*:.*:SAMTOOLS_VIEW' {
        ext.args = '-b -F 4'
        ext.prefix = { "${meta.id}.mapped.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/align" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:.*:.*:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/align" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:.*:.*:BAM_STATS_SAMTOOLS:.*' {
        ext.prefix = { "${meta.id}.mapped.sorted.bam" }
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/samtools_stats" },
            mode: params.publish_dir_mode,
            pattern: "*.{stats,flagstat,idxstats}"
        ]
    }

    withName: '.*:.*:BCFTOOLS_STATS' {
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/bcftools_stats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAKE_BED_MASK' {
        ext.args = "-a --ignore-overlaps --count-orphans --no-BAQ --max-depth 0 --min-BQ 0"
        ext.args2 = 10
        ext.prefix = { "${meta.id}.coverage.masked" }
        publishDir = [
            path: { "${params.outdir}/${params.mapper_nanopore}/bcftools" },
            mode: params.publish_dir_mode,
            pattern: "*.mpileup",
            enabled: params.save_mpileup
        ]
    }

    withName: 'BEDTOOLS_MERGE' {
        ext.prefix = { "${meta.id}.coverage.merged" }
        publishDir = [
        path: { "${params.outdir}/${params.mapper_nanopore}/bcftools" },
            enabled: false
        ]
    }

    withName: 'BEDTOOLS_MASKFASTA' {
        ext.prefix = { "${meta.id}.masked" }
        publishDir = [
        path: { "${params.outdir}/${params.mapper_nanopore}/bcftools" },
            enabled: false
        ]
    }

    withName: 'BCFTOOLS_CONSENSUS' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
        path: { "${params.outdir}/${params.mapper_nanopore}/bcftools" },
            enabled: false
        ]
    }

    withName: 'RENAME_FASTA_HEADER' {
        ext.prefix = { "${meta.id}.consensus" }
        publishDir = [
        path: { "${params.outdir}/${params.mapper_nanopore}/bcftools" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

//
// Optional configuration options
//

    process {
        withName: 'PYCOQC' {
            ext.prefix = 'pycoqc'
            publishDir = [
                path: { "${params.outdir}/pycoqc" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }

    process {
        withName: 'NANOPLOT' {
            publishDir = [
                path: { "${params.outdir}/nanoplot/${meta.id}" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }

    process {
        withName: 'COLLAPSE_PRIMERS' {
            publishDir = [
                path: { "${params.outdir}/genome" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }

        withName: 'MOSDEPTH_GENOME' {
            ext.args = '--fast-mode --by 200'
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/mosdepth/genome" },
                mode: params.publish_dir_mode,
                pattern: "*.summary.txt"
            ]
        }

        withName: 'PLOT_MOSDEPTH_REGIONS_GENOME' {
            ext.args = '--input_suffix .regions.bed.gz'
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/mosdepth/genome" },
                mode: params.publish_dir_mode,
                pattern: "*.{tsv,pdf}"
            ]
        }

        withName: 'MOSDEPTH_AMPLICON' {
            ext.args = '--fast-mode --use-median --thresholds 0,1,10,50,100,500'
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/mosdepth/amplicon" },
                mode: params.publish_dir_mode,
                pattern: "*.summary.txt"
            ]
        }

        withName: 'PLOT_MOSDEPTH_REGIONS_AMPLICON' {
            ext.args = '--input_suffix .regions.bed.gz'
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/mosdepth/amplicon" },
                mode: params.publish_dir_mode,
                pattern: "*.{tsv,pdf}"
            ]
        }
    }

    process {
        withName: 'PANGOLIN_RUN' {
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/pangolin" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'PANGOLIN_UPDATEDATA' {
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/pangolin" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
        withName: 'UNTAR_PANGODB' {
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/pangolin" },
                enabled: false
            ]
        }
    }

    process {
        withName: 'UNTAR' {
            publishDir = [
                path: { "${params.outdir}/genome" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }

        withName: 'NEXTCLADE_DATASETGET' {
            publishDir = [
                path: { "${params.outdir}/genome" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }

        withName: 'NEXTCLADE_RUN' {
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/nextclade" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.endsWith(".csv") && !filename.endsWith("errors.csv") && !filename.endsWith("insertions.csv") ? filename : null }
            ]
        }
    }

    process {
        withName: 'FREYJA_VARIANTS' {
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/freyja/variants" },
                mode: params.publish_dir_mode,
                pattern: "*.{tsv,csv}"
            ]
        }

        withName: 'FREYJA_DEMIX' {
            ext.args = [
                params.freyja_depthcutoff ? "--depthcutoff ${params.freyja_depthcutoff}" : '',
            ].join(' ').trim()
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/freyja/demix" },
                mode: params.publish_dir_mode,
                pattern: "*.{tsv,csv}"
            ]
        }

        withName: 'FREYJA_BOOT' {
            ext.args = [
                params.freyja_depthcutoff ? "--depthcutoff ${params.freyja_depthcutoff}" : '',
                '--boxplot pdf',
            ].join(' ').trim()
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/freyja/bootstrap" },
                mode: params.publish_dir_mode,
                pattern: "*.{tsv,csv,pdf}"
            ]
        }

        withName: 'FREYJA_UPDATE' {
            ext.args = [
                    params.freyja_db_name ? "--pathogen ${params.freyja_db_name}" : ''
                ].join(' ').trim()
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/freyja/" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            ]
        }
    }

    process {
        withName: 'QUAST' {
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}" },
                mode: params.publish_dir_mode,
                pattern: "quast"
            ]
        }
    }

    process {
        withName: 'SNPEFF_BUILD' {
            publishDir = [
                path: { "${params.outdir}/genome" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_reference
            ]
        }

        withName: 'SNPEFF_ANN' {
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/snpeff" },
                mode: params.publish_dir_mode,
                pattern: "*.{csv,txt,html}"
            ]
        }

        withName: '.*:.*:.*:.*:TABIX_BGZIP' {
            ext.prefix = { "${meta.id}.snpeff" }
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/snpeff" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: '.*:.*:.*:.*:.*:TABIX_TABIX' {
            ext.args = '-p vcf -f'
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/snpeff" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: '.*:.*:.*:.*:.*:BCFTOOLS_STATS' {
            ext.prefix = { "${meta.id}.snpeff" }
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/snpeff/bcftools_stats" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'SNPSIFT_EXTRACTFIELDS' {
            publishDir = [
                path: { "${params.outdir}/${params.mapper_nanopore}/snpeff" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }

        process {
            withName: 'BCFTOOLS_QUERY' {
                ext.args = "-H -f '%CHROM\\t%POS\\t%REF\\t%ALT\\t%FILTER\\t[%DP\\t]\\t[%AD\\t]\\n'"
                ext.prefix = { "${meta.id}.bcftools_query" }
                publishDir = [
                    path: { "${params.outdir}/${params.mapper_nanopore}" },
                    enabled: false
                ]
            }

            withName: 'MAKE_VARIANTS_LONG_TABLE' {
                ext.args = "--variant_caller ${params.mapper_nanopore == 'minimap2' ? 'clair3' : 'artic'}"
                publishDir = [
                    path: { "${params.outdir}/${params.mapper_nanopore}" },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
            }
            withName: 'MAKE_VARIANTS_LONG_TABLE_ADDITIONAL' {
                ext.args = "--variant_caller ${params.mapper_nanopore == 'minimap2' ? 'clair3' : 'artic'} --output_file 'additional_variants_long_table.csv'"
                publishDir = [
                    path: { "${params.outdir}/${params.mapper_nanopore}" },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
            }
        }

    process {
        withName: 'MULTIQC' {
            ext.args   = [
                '-k yaml',
                params.multiqc_title ? "--title \"$params.multiqc_title\"" : ''
            ].join(' ').trim()
            publishDir = [
                path: { "${params.outdir}/multiqc/" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
