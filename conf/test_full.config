/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/viralrecon -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // Input data for full test of amplicon analysis
    input              = "${params.pipelines_testdata_base_path}/samplesheet/v2.6/samplesheet_full_amplicon_illumina.csv"
    platform           = 'illumina'
    trim_primers       = true
    primer_set         = 'artic'
    primer_set_version = 3

    // Genome references
    genome = 'MN908947.3'

    // Variant calling options
    variant_caller     = 'ivar'

    // Freyja db consistency options
    freyja_repeats            = 10
    freyja_depthcutoff        = 1
    skip_freyja_boot          = true
    freyja_barcodes           = "${params.pipelines_testdata_base_path}/genome/freyja/usher_barcodes.feather"
    freyja_lineages_meta      = "${params.pipelines_testdata_base_path}/genome/freyja/curated_lineages.json"
    freyja_lineages_topology  = "${params.pipelines_testdata_base_path}/genome/freyja/lineages.yml"

    // Assembly options
    assemblers     = 'spades,unicycler,minia'

}

process {
    withName: 'PLASMIDID' {
        errorStrategy = 'ignore'
    }
}
